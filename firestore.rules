rules_version = '2';
// Reglas de seguridad de Firestore para LIV — Liga La Cuarta.
// Cópialas en: Firebase Console → Firestore Database → Rules → Publish.
//
// Modelo:
//  - Lo público (fixture, disciplina, config, equipos, audiovisual) se LEE sin login.
//  - partidos y disciplina: los escribe cualquier usuario autenticado (admin o planillero).
//  - config, equipos, audiovisual: solo ADMIN (pega el/los UID de admin abajo).
//  - inscripciones: cualquiera puede crear (formulario público); solo admin lee/edita.
service cloud.firestore {
  match /databases/{database}/documents {

    // >>> PEGA AQUÍ EL/LOS UID DE ADMIN (Firebase Console → Authentication → Users) <<<
    function admins() {
      return [
        'QltrN298mHMeAw04K3dZb5SJ7I33'
      ];
    }
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.uid in admins(); }

    // Calendario / resultados: lee todo el mundo; escribe cualquier cuenta (admin o planillero).
    match /partidos/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    // Tarjetas y sanciones: igual que partidos.
    match /disciplina/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    // Goleadores (si se usa): lee público, escribe autenticado.
    match /goleadores/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Contenido de la liga: lee público, escribe solo admin.
    match /config/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /equipos/{id}   { allow read: if true; allow write: if isAdmin(); }

    // Inscripciones: cualquiera crea (formulario de Admisión); solo admin lee/edita/borra.
    match /inscripciones/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Todo lo demás, cerrado.
    match /{document=**} { allow read, write: if false; }
  }
}
