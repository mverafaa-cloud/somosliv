# La web pública NO necesita variables de entorno (la config de Firebase es
# pública y va en public/firebase-config.js).
#
# Este archivo solo aplica si más adelante agregas Netlify Functions con
# secretos (ej. envío de emails, pagos, o el Admin SDK de Firebase).

# Firebase Admin SDK (solo para functions server-side; NO commitear el real)
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# URL pública del sitio (para links en emails/webhooks)
# PUBLIC_BASE_URL=https://liv.cl
